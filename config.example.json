{
  "version": "0.2.1",
  "server": {
    "host": "127.0.0.1",
    "port": 8070
  },
  "authorization": {
    "enabled": true,
    "token": "lightd_change_me_generate_a_real_token",
    "allowed_origins": ["http://localhost:3000"]
  },
  "docker": {
    "socket_path": "/var/run/docker.sock"
  },
  "storage": {
    "base_path": "/var/lib/lightd/storage",
    "containers_path": "/var/lib/lightd/storage/containers",
    "volumes_path": "/var/lib/lightd/storage/volumes"
  },
  "monitoring": {
    "enabled": true,
    "interval_ms": 1000,
    "billing": {
      "memory_per_gb_hour": 0.01,
      "cpu_per_vcpu_hour": 0.02,
      "storage_per_gb_hour": 0.0001,
      "egress_per_gb": 0.05
    }
  },
  "remote": {
    "enabled": false,
    "url": "https://your-remote-api.com/api",
    "token": "lightd_change_me_remote_token"
  },
  "sftp": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 2022
  }
}